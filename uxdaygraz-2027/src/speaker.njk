---
layout: base.njk
pagination:
  data: speakers
  size: 1
  alias: speaker
permalink: "speakers/{{ speaker.slug }}.html"
root: "../"
eleventyComputed:
  title: "{{ speaker.name }}"
---
<p><a href="../speakers.html">← Back to all speakers</a></p>

<div class="speaker-layout">
  <div class="speaker-info">
    <h3>{{ speaker.role }}</h3>
    {% if speaker.company %}<p>{{ speaker.company }}</p>{% endif %}

    <h4>Roles:</h4>
    <p>{{ speaker.roles }}</p>

    {% if speaker.talk %}
    <h4>Session</h4>
    <p>{{ speaker.talk }}</p>
    {% endif %}
  </div>

  <div>
    <img class="speaker-photo" src="{{ root }}assets/images/{{ speaker.photo }}" alt="Portrait of {{ speaker.name }}">
  </div>

  <div class="speaker-contact">
    <h3>Web</h3>
    <p><a href="https://example.com">Personal Website</a></p>

    <h3>Social</h3>
    <p>@{{ speaker.slug }}</p>
  </div>
</div>

<div class="speaker-bio">
  <h2>About {{ speaker.name }}</h2>
  <p>{{ speaker.bio }}</p>
  {% if speaker.additionalBio %}<p>{{ speaker.additionalBio }}</p>{% endif %}

  {% if speaker.talk %}
  <h2>About the talk: {{ speaker.talk }}</h2>
  <p>{{ speaker.abstract }}</p>
  {% endif %}
</div>
