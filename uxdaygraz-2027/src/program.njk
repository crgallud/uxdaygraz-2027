---
layout: base.njk
permalink: "program.html"
title: Program
---
<main>
  <h2>Conference program</h2>

  <table class="schedule">
    <thead>
      <tr>
        <th>Time</th>
        <th>Session</th>
        <th>Speaker</th>
      </tr>
    </thead>
    <tbody>
      {% for session in program %}
      {% for speaker in speakers %}
      {% if speaker.slug == session.speaker %}
      <tr>
        <td>{{ session.time }}</td>
        <td>{{ speaker.talk }}</td>
        <td><a href="speakers/{{ speaker.slug }}.html">{{ speaker.name }}</a></td>
      </tr>
      {% endif %}
      {% endfor %}
      {% endfor %}
    </tbody>
  </table>

  <p><a href="speakers.html">View all speakers</a></p>
</main>
