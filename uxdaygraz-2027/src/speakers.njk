---
layout: base.njk
permalink: "speakers.html"
title: Speakers
---
<main>
  <h2>Meet the speakers</h2>
  <p>Learn more about the people featured in the conference program.</p>

  <div class="speaker-grid">
    {% for speaker in speakers %}
    <a class="speaker-card" href="speakers/{{ speaker.slug }}.html">
      <img src="assets/images/{{ speaker.photo }}" alt="Portrait of {{ speaker.name }}">
      <h3>{{ speaker.name }}</h3>
      <p>{{ speaker.role }}</p>
      <p>View profile →</p>
    </a>
    {% endfor %}
  </div>
</main>
